{
  "manifest_version": 3,
  "name": "Text Marker",
  "version": "1.1",
  "description": "Markiere Text, bearbeite ihn und speichere ihn.",
  "permissions": ["storage", "scripting", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon16.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["modal.css"]
    }
  ]
}
